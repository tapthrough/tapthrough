{
  "name": "@tapthrough/expo",
  "version": "0.1.0",
  "description": "Tapthrough SDK for Expo: opens a pull request preview on the right screen, logged in with seeded data",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tapthrough/tapthrough.git",
    "directory": "packages/expo"
  },
  "homepage": "https://github.com/tapthrough/tapthrough/tree/main/packages/expo",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "app.plugin.js",
    "app.plugin.d.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./supabase": {
      "types": "./dist/supabase.d.ts",
      "default": "./dist/supabase.js"
    },
    "./app.plugin": {
      "types": "./app.plugin.d.ts",
      "default": "./app.plugin.js"
    },
    "./app.plugin.js": {
      "types": "./app.plugin.d.ts",
      "default": "./app.plugin.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@tapthrough/protocol": "workspace:^"
  },
  "peerDependencies": {
    "expo-constants": ">=17",
    "expo-linking": ">=7",
    "expo-router": ">=4",
    "react": ">=18",
    "react-native": ">=0.76"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.118.0",
    "@types/react": "19.3.0",
    "expo-constants": "58.0.12",
    "expo-linking": "58.0.13",
    "expo-router": "58.0.23",
    "react": "19.3.1",
    "react-native": "0.88.0"
  }
}
