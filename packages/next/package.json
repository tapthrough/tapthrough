{
  "name": "@tapthrough/next",
  "version": "0.1.3",
  "description": "Tapthrough SDK for Next.js: opens a pull request's preview deployment on the right page, logged in with seeded data",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tapthrough/tapthrough.git",
    "directory": "packages/next"
  },
  "homepage": "https://github.com/tapthrough/tapthrough/tree/main/packages/next",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./panel": {
      "types": "./dist/panel.d.ts",
      "default": "./dist/panel.js"
    },
    "./authjs": {
      "types": "./dist/authjs.d.ts",
      "default": "./dist/authjs.js"
    },
    "./supabase": {
      "types": "./dist/supabase.d.ts",
      "default": "./dist/supabase.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@tapthrough/core": "workspace:^",
    "@tapthrough/protocol": "workspace:^",
    "@tapthrough/react": "workspace:^"
  },
  "peerDependencies": {
    "@supabase/ssr": ">=0.5",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "@supabase/ssr": {
      "optional": true
    }
  },
  "devDependencies": {
    "@supabase/ssr": "0.10.3",
    "@supabase/supabase-js": "2.118.0",
    "@tapthrough/seed": "workspace:^",
    "@types/react": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  }
}
