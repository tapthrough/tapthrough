{
  "name": "@tapthrough/react",
  "version": "0.1.2",
  "description": "Tapthrough's Review panel for React web apps: the PR's checklist, pass and fail, and reports, inside the preview",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tapthrough/tapthrough.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/tapthrough/tapthrough/tree/main/packages/react",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@tapthrough/core": "workspace:^",
    "@tapthrough/protocol": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "21.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
