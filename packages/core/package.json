{
  "name": "@tapthrough/core",
  "version": "0.1.1",
  "description": "Tapthrough's platform-neutral SDK logic: the launch sequence, reports, the review checklist and flags",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tapthrough/tapthrough.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/tapthrough/tapthrough/tree/main/packages/core",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@tapthrough/protocol": "workspace:^"
  }
}
