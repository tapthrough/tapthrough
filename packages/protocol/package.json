{
  "name": "@tapthrough/protocol",
  "version": "0.1.0",
  "description": "Versioned schemas and link-token helpers shared by every Tapthrough component",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tapthrough/tapthrough.git",
    "directory": "packages/protocol"
  },
  "homepage": "https://github.com/tapthrough/tapthrough/tree/main/packages/protocol",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "jose": "6.2.12",
    "zod": "4.6.7"
  }
}
