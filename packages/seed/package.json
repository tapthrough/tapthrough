{
  "name": "@tapthrough/seed",
  "version": "0.1.0",
  "description": "Seed-hook handler for Tapthrough: verifies a link token, runs a preset and returns a logged-in session",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tapthrough/tapthrough.git",
    "directory": "packages/seed"
  },
  "homepage": "https://github.com/tapthrough/tapthrough/tree/main/packages/seed",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./supabase": {
      "types": "./dist/supabase.d.ts",
      "default": "./dist/supabase.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@tapthrough/protocol": "workspace:^"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@supabase/supabase-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.118.0",
    "zod": "4.6.7"
  }
}
